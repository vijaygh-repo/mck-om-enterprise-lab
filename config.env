# Versions and sizing for the lab. Override any value from the environment, e.g.
#   MDB_VERSION=8.0.32-ent sudo -E ./mck-om-lab.sh
# Verified on 2026-09-30: the MCK 1.13.0 release lists Ops Manager 9.0.0 and agent 109.0.0.

# --- Container tooling (kind + kubectl) ---
KIND_VERSION="${KIND_VERSION:-v0.33.0}"
# kind's default node image is Kubernetes 1.37, which is newer than anything MCK 1.13.0 documents,
# so the node image and kubectl are pinned to 1.34.
KIND_NODE_IMAGE="${KIND_NODE_IMAGE:-kindest/node:v1.34.11}"
KUBECTL_VERSION="${KUBECTL_VERSION:-v1.34.11}"
KIND_CLUSTER_NAME="${KIND_CLUSTER_NAME:-mck-lab}"

# --- MongoDB Controllers for Kubernetes (MCK), Ops Manager, MongoDB Enterprise ---
MCK_VERSION="${MCK_VERSION:-1.13.0}"
OM_VERSION="${OM_VERSION:-9.0.0}"
# Ops Manager's own database. Backing databases must be a major-release series such as 8.0.
APPDB_VERSION="${APPDB_VERSION:-8.0.32-ent}"
# Latest MongoDB Enterprise; its build is in Ops Manager 9's version manifest.
MDB_VERSION="${MDB_VERSION:-9.0.2-ent}"

# --- Names ---
NAMESPACE="${NAMESPACE:-mongodb}"
OM_NAME="${OM_NAME:-ops-manager}"
OM_NODEPORT="${OM_NODEPORT:-30080}"
OM_HOST_PORT="${OM_HOST_PORT:-8080}"
OM_ADMIN_USER="${OM_ADMIN_USER:-admin@example.com}"
PROJECT_NAME="${PROJECT_NAME:-mck-lab-project}"
RS_NAME="${RS_NAME:-my-replica-set}"

# --- Sizing (fits a 16 GiB host; use 32 GiB for more headroom) ---
OM_HEAP="${OM_HEAP:-3g}"
APPDB_STORAGE="${APPDB_STORAGE:-5Gi}"
RS_STORAGE="${RS_STORAGE:-5Gi}"
# Caps the WiredTiger cache of every mongod; the default is half of the node's RAM per pod.
MONGOD_CACHE_GB="${MONGOD_CACHE_GB:-0.25}"
